# Port the service listens on. Render sets this automatically in production.
PORT=4001

# Comma-separated list of allowed frontend origins (your Netlify URL(s)).
# Leave unset ("*") only for local development.
PARTY_CORS_ORIGIN=https://your-netlify-site.netlify.app,http://localhost:5173

# Where room-state snapshots and uploaded media are stored on disk.
# On Render, point these at a mounted persistent disk so they survive restarts/redeploys.
PARTY_DATA_DIR=./data
PARTY_UPLOAD_DIR=./uploads

# Max size (MB) for a single uploaded video/audio file.
PARTY_MAX_UPLOAD_MB=800

# How long an inactive room is kept before being purged.
PARTY_ROOM_TTL_HOURS=12

# How long (ms) to wait after a socket disconnects before treating it as a
# real leave — covers brief wifi drops / phone locks without ending the room
# or triggering an auto host-transfer.
PARTY_DISCONNECT_GRACE_MS=20000
